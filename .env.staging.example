# Staging environment template. Copy to .env (or inject as real environment
# variables in whatever runs staging — this file is never read automatically,
# same as .env.example) and replace every placeholder below. Never commit a
# filled-in copy.

ENVIRONMENT=staging
LOG_LEVEL=INFO

# Managed Postgres/pgvector instance for staging — not the local docker-compose db.
DATABASE_URL=postgresql+psycopg://REPLACE_ME:REPLACE_ME@REPLACE_ME_STAGING_HOST:5432/cka

SOURCES_REGISTRY_PATH=data/sources/registry.yaml

# Real key required for real /ask answers to be exercised in staging — without
# it, /ask still runs (FakeLLMProvider fallback) but generation-quality gates
# (citation_accuracy/faithfulness/answer_relevance) stay unchecked, same as
# every block's local dev so far.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Sprint 09 — security. Settings._forbid_dev_jwt_secret_in_production only
# hard-fails when ENVIRONMENT=production, but staging should still never
# share the dev-only default — generate a real secret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_ME_GENERATE_A_REAL_SECRET_AT_LEAST_32_BYTES
ACCESS_TOKEN_EXPIRE_MINUTES=30
RATE_LIMIT_PER_MINUTE=60

# Sprint 11 — observability. Staging's Jaeger/OTLP collector endpoint, not
# the docker-compose service name used in local dev.
OTLP_ENDPOINT=http://REPLACE_ME_STAGING_OTLP_HOST:4317
OTEL_TRACES_ENABLED=true

# Read by docker-compose.yml, not the app itself.
GRAFANA_ADMIN_PASSWORD=REPLACE_ME_GENERATE_A_REAL_PASSWORD
