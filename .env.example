ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://cka:cka@localhost:5434/cka

SOURCES_REGISTRY_PATH=data/sources/registry.yaml

# Block 2 — RAG core. ANTHROPIC_API_KEY is optional: without it, /ask still
# works using FakeLLMProvider in tests, but real generation is unavailable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Block 3 — observability. Leave false for local `uv run` dev (no Jaeger on
# the host) — the Docker Compose stack overrides this to true.
OTEL_TRACES_ENABLED=false

# Block 4 — read by docker-compose.yml (not by the app itself) to set
# Grafana's admin password. Blank here falls back to a clearly-marked
# dev-only default in docker-compose.yml — set a real value for anything
# beyond throwaway local dev.
GRAFANA_ADMIN_PASSWORD=
