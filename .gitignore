# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets
.env
.env.*
!.env.example
!.env.staging.example
!.env.production.example

# Tooling / coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.log

# Terraform (infra/) — real state/vars files, never the .example templates
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

