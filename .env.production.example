# Production environment template. Copy to .env (or, preferably, inject as
# real secrets from whatever secret manager production uses) and replace
# every placeholder below. Never commit a filled-in copy.
#
# ENVIRONMENT=production is not cosmetic: Settings._forbid_dev_jwt_secret_in_production
# (src/cka/core/config.py) refuses to start if JWT_SECRET_KEY is still the
# dev-only default, or shorter than 32 bytes — this is enforced in code, not
# just documented here.

ENVIRONMENT=production
LOG_LEVEL=WARNING

# Managed Postgres/pgvector instance for production.
DATABASE_URL=postgresql+psycopg://REPLACE_ME:REPLACE_ME@REPLACE_ME_PRODUCTION_HOST:5432/cka

SOURCES_REGISTRY_PATH=data/sources/registry.yaml

# Required for real /ask answers and for the generation-quality evaluation
# gates (citation_accuracy/faithfulness/answer_relevance) to be enforced —
# without it the app still runs, but on the FakeLLMProvider fallback, which
# is not an acceptable production configuration.
ANTHROPIC_API_KEY=REPLACE_ME
ANTHROPIC_MODEL=claude-sonnet-5

# Sprint 09 — security. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Startup fails fast (by design) if this is left as the dev-only default or
# under 32 bytes — see Settings._forbid_dev_jwt_secret_in_production.
JWT_SECRET_KEY=REPLACE_ME_GENERATE_A_REAL_SECRET_AT_LEAST_32_BYTES
ACCESS_TOKEN_EXPIRE_MINUTES=30
RATE_LIMIT_PER_MINUTE=60

# Sprint 11 — observability. Production's Jaeger/OTLP collector endpoint.
OTLP_ENDPOINT=http://REPLACE_ME_PRODUCTION_OTLP_HOST:4317
OTEL_TRACES_ENABLED=true

# Read by docker-compose.yml, not the app itself. Required — never leave the
# dev-only default in any environment beyond throwaway local dev.
GRAFANA_ADMIN_PASSWORD=REPLACE_ME_GENERATE_A_REAL_PASSWORD
